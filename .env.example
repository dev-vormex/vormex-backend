# Database
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Secret
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_CSRF_SECRET=replace-with-a-different-32-byte-random-secret
AUTH_ACCESS_TOKEN_TTL=1000d
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400000
AUTH_REQUIRE_SESSION_ID=true
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Set to .vormex.in when the frontend and API are same-site subdomains.
AUTH_COOKIE_DOMAIN=

# Server (backend :5000, web :3000)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback

# Google OAuth
# NEXT_PUBLIC_GOOGLE_CLIENT_ID in the web/admin apps must match GOOGLE_CLIENT_ID_WEB.
# GOOGLE_CLIENT_SECRET belongs on the backend only.
GOOGLE_CLIENT_ID_WEB=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001

# Encryption Key (must be exactly 64 hex characters - 32 bytes)
ENCRYPTION_KEY=REMOVED_SECRET

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@your-verified-domain.com

# Bunny.net Storage & CDN
BUNNY_STORAGE_ZONE_NAME=vormex-storage
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_REGION=sg
BUNNY_STORAGE_HOSTNAME=sg.storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=vormex.b-cdn.net
BUNNY_PULL_ZONE_URL=https://vormex.b-cdn.net

# Bunny Stream (Video Transcoding & HLS Streaming)
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=your-bunny-stream-library-id
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxx-xxx.b-cdn.net
BUNNY_STREAM_WEBHOOK_SECRET=your-webhook-secret

# Razorpay Premium Checkout
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
VORMEX_PREMIUM_PLAN=premium
VORMEX_PREMIUM_TITLE=Vormex Premium
VORMEX_PREMIUM_DESCRIPTION=Priority discovery, profile reach boosts, unlimited outreach, profile projects, collaboration applications, and AI help for serious student builders.
VORMEX_PREMIUM_MONTHLY_AMOUNT_MINOR=19900
VORMEX_PREMIUM_YEARLY_AMOUNT_MINOR=99900
VORMEX_PREMIUM_CURRENCY=INR
VORMEX_PREMIUM_BILLING_CYCLE=monthly
VORMEX_AGENT_PROMPT_LIMIT=5

# Google Play Billing Premium verification (Android Play-distributed app)
GOOGLE_PLAY_PACKAGE_NAME=com.vormex.android
GOOGLE_PLAY_PREMIUM_PRODUCT_ID=vormex_premium
GOOGLE_PLAY_PREMIUM_MONTHLY_BASE_PLAN_ID=premium-monthly-prepaid
GOOGLE_PLAY_PREMIUM_YEARLY_BASE_PLAN_ID=premium-yearly-prepaid
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Cache / queues / distributed rate limiting.
# Realtime chat works without Redis on a single API process; keep Redis enabled for workers,
# distributed rate limits, and multi-instance Socket.IO fanout.
REDIS_URL=redis://localhost:6379
# Production requires Redis by default. Set REDIS_REQUIRED=false only for a single-instance
# deployment where queue workers/distributed rate limits are intentionally disabled.
REDIS_REQUIRED=true
# Local/dev resilience knobs for flaky remote Redis links.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_OPTIONAL_RETRY_ATTEMPTS=1
REDIS_ERROR_LOG_THROTTLE_MS=30000

# Abuse protection / rate limiting
RATE_LIMIT_API_IP_PER_MINUTE=120
RATE_LIMIT_API_IP_PER_HOUR=3000
RATE_LIMIT_API_USER_PER_MINUTE=600
RATE_LIMIT_API_USER_PER_HOUR=10000
RATE_LIMIT_READ_HEAVY_ANON_IP_PER_HOUR=600
RATE_LIMIT_AUTOMATED_IP_PER_MINUTE=20
RATE_LIMIT_PAYMENT_USER_PER_10_MINUTES=6
RATE_LIMIT_PAYMENT_IP_PER_10_MINUTES=20
RATE_LIMIT_PAYMENT_USER_PER_HOUR=20
RATE_LIMIT_PAYMENT_IP_PER_HOUR=60
RATE_LIMIT_AI_HELPER_USER_PER_5_MINUTES=20
RATE_LIMIT_AI_HELPER_IP_PER_5_MINUTES=80
RATE_LIMIT_AI_HELPER_USER_PER_HOUR=120
RATE_LIMIT_AI_HELPER_IP_PER_HOUR=300
RATE_LIMIT_AI_CAREER_USER_PER_5_MINUTES=8
RATE_LIMIT_AI_CAREER_IP_PER_5_MINUTES=30
RATE_LIMIT_AI_CAREER_USER_PER_HOUR=40
RATE_LIMIT_AI_CAREER_IP_PER_HOUR=100

# Firebase App Check for mobile attestation.
# Modes: off, monitor, sensitive, all. "monitor" verifies provided tokens without blocking.
APP_CHECK_ENFORCEMENT=monitor
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="replace-with-escaped-private-key"

# Logging
LOG_LEVEL=info

# Re-engagement notification campaign (IST-aligned hourly slots)
REENGAGEMENT_ENABLED=true
REENGAGEMENT_SLOT_HOURS_IST=15,16,17,18,19,20,21,22,23,0
REENGAGEMENT_MAX_PER_DAY=10
REENGAGEMENT_LOOKBACK_DAYS=30
REENGAGEMENT_MATCH_POOL_SIZE=12

# Automatic "new match available" notifications (same college / skills / interests / goal)
MATCH_AVAILABILITY_NOTIFICATIONS_ENABLED=true
MATCH_AVAILABILITY_NOTIFICATIONS_COOLDOWN_HOURS=24
MATCH_AVAILABILITY_NOTIFICATIONS_LOOKBACK_DAYS=45
MATCH_AVAILABILITY_NOTIFICATIONS_MAX_RECIPIENTS=150

# Text agent (Gemini SDK; backend only, never expose this key to Android)
GEMINI_API_KEY=your-gemini-api-key
AGENT_GEMINI_MODEL=gemini-2.5-flash
AGENT_GEMINI_TIMEOUT_MS=45000
AGENT_GEMINI_MAX_OUTPUT_TOKENS=700

# Optional voice helpers used only by legacy/global voice surfaces.
OPENAI_API_KEY=your-openai-api-key
AI_API_KEY=your-openai-api-key
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=260
