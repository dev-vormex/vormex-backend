GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=your-google-play-service-account-json-base64

# Cache / queues / distributed coordination.
# Production uses two Redis roles. Critical Redis must be persistent/noeviction;
# cache Redis may use an eviction policy. REDIS_URL is only a local/legacy fallback.
CRITICAL_REDIS_URL=redis://localhost:6379
CACHE_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379
CRITICAL_REDIS_REQUIRED=false
CACHE_REDIS_REQUIRED=false
# Bounded degraded-mode L1 used only when cache Redis is unavailable.
CACHE_MEMORY_MAX_ENTRIES=1000
# Legacy switch: equivalent to CRITICAL_REDIS_REQUIRED=true.
REDIS_REQUIRED=false
# Local/dev resilience knobs for flaky remote Redis links.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_OPTIONAL_RETRY_ATTEMPTS=1
REDIS_ERROR_LOG_THROTTLE_MS=30000
# API Redis mode: auto connects in production/local Redis, but skips remote Upstash in dev.
# Use true for multi-instance Socket.IO fanout or false to force local in-memory fallbacks.
API_REDIS_MODE=auto
# npm run dev starts background jobs only for local Redis by default.
# Use true when you intentionally want local BullMQ workers against REDIS_URL.
DEV_BACKGROUND_JOBS=auto
# Use low concurrency on starter/low-quota Redis providers. Increase after upgrading Redis.
WORKER_CONCURRENCY=1
WORKER_ERROR_LOG_THROTTLE_MS=30000
BACKGROUND_PROCESSES_REQUIRED=false
BACKGROUND_HEARTBEAT_INTERVAL_MS=10000
BACKGROUND_HEARTBEAT_TTL_SECONDS=45
BACKGROUND_HEARTBEAT_STALE_AFTER_MS=30000
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=5
OUTBOX_DISPATCH_INTERVAL_MS=30000
OUTBOX_REALTIME_MAX_AGE_MS=300000
OUTBOX_CACHE_INVALIDATION_MAX_AGE_MS=3600000
OUTBOX_NOTIFICATION_MAX_AGE_MS=86400000
OUTBOX_ANALYTICS_MAX_AGE_MS=604800000
OUTBOX_UNKNOWN_HISTORICAL_MAX_AGE_MS=86400000
# Direct keeps Android chat push notifications working when local development
# runs only the API process. Production defaults to the durable outbox worker.
CHAT_PUSH_DELIVERY_MODE=direct
# Do not deliver queued chat pushes after their useful notification window.
CHAT_PUSH_MAX_AGE_MS=86400000

# Abuse protection / rate limiting
RATE_LIMIT_API_IP_PER_MINUTE=120
RATE_LIMIT_API_IP_PER_HOUR=3000
RATE_LIMIT_API_USER_PER_MINUTE=600
RATE_LIMIT_API_USER_PER_HOUR=10000
