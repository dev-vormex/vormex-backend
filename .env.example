# Unified recommendations (all disabled for a safe migration-first rollout)
RECOMMENDATION_EVENTS_ENABLED=false
RECOMMENDATION_SEMANTIC_ENABLED=false
RECOMMENDATION_SHADOW_MODEL_ENABLED=false
RECOMMENDATION_TREATMENT_ENABLED=false
RECOMMENDATION_TREATMENT_SHARE=0.05
RECOMMENDATION_POSITION_EXPLORATION_ENABLED=false
RECOMMENDATION_POSITION_EXPLORATION_SHARE=0.05
RECOMMENDATION_RANKER_VERSION=vormex-unified-v1
RECOMMENDATION_CURSOR_SECRET=replace-with-a-long-random-secret
NAMED_ACTIVITY_RECOMMENDATIONS_LEGAL_BASIS_APPROVED=false
PREMIUM_POST_BOOST_ENABLED=false
JWT_EXPIRES_IN=15m
AUTH_SESSION_TTL_SECONDS=2592000
JWT_SECRET=your-jwt-secret
DEVICE_LINK_SECRET=replace-with-a-random-device-link-secret
NODE_ENV=development
# API docs are disabled by default in production; enable only in a protected environment.
API_DOCS_ENABLED=false
# Request logs omit user IDs and IP addresses unless explicitly enabled for a documented need.
LOG_INCLUDE_IDENTIFIERS=false
# Higher rate limits for local development with multiple devices sharing same IP
RATE_LIMIT_API_IP_PER_MINUTE=600
RATE_LIMIT_API_IP_PER_HOUR=15000
RATE_LIMIT_API_FINGERPRINT_PER_MINUTE=400
RATE_LIMIT_API_USER_PER_MINUTE=3000
RATE_LIMIT_API_USER_PER_HOUR=50000
RATE_LIMIT_API_WRITE_IP_PER_MINUTE=400
RATE_LIMIT_API_WRITE_USER_PER_MINUTE=1200
OPENAI_API_KEY=your-openai-api-key
# Required in production for the OpenAI Apps verification endpoint. Never commit the issued token.
OPENAI_APPS_CHALLENGE_TOKEN=

# Public web, search-engine, and AI discovery
PUBLIC_WEB_BASE_URL=https://www.vormex.in
PUBLIC_API_BASE_URL=https://vormex-backend.onrender.com
PUBLIC_SEO_ENABLED=true
PUBLIC_AI_DISCOVERY_ENABLED=true
MCP_ENABLED=true
DISCOVERY_EMBEDDING_MODEL=text-embedding-3-small
INDEXNOW_KEY=
AI_MODEL=gpt-5.4-nano
AGENT_DEFAULT_MODEL=gpt-5.4-nano
AGENT_PLANNER_MODEL=gpt-5.4-nano
PORT=5000
REDIS_URL=rediss://default:your-password@your-upstash-host:6379
RESEND_API_KEY=your-resend-api-key
XAI_API_KEY=your-xai-api-key
AGENT_XAI_MODEL=grok-4.3
AGENT_XAI_REASONING_EFFORT=none

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=vormex-c42f6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@vormex-c42f6.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your-firebase-private-key


VORMEX_ADMOB_APPLICATION_ID=ca-app-pub-9064524216997523~3887835773
VORMEX_ADMOB_NATIVE_FEED_AD_UNIT_ID=ca-app-pub-9064524216997523/5142781501
VORMEX_ADS_ENABLED=true


# Database
# Production app traffic should use a transaction-mode pooler endpoint
# (PgBouncer, Supabase/Neon pooled connection, RDS Proxy, etc), not the
# direct Postgres host. Keep connection_limit small per API/worker instance.
DATABASE_URL=postgresql://user:password@pooler-host:6543/database?sslmode=require&pgbouncer=true&connection_limit=3
# Prisma migrate needs a direct Postgres connection. Do not point DIRECT_URL at
# transaction-mode PgBouncer.
DIRECT_URL=postgresql://user:password@direct-postgres-host:5432/database?sslmode=require
# Optional read replica URL. If set in production, prefer the read pooler too.
READ_DATABASE_URL=
PRISMA_CONNECTION_LIMIT=3
PRISMA_READ_CONNECTION_LIMIT=3
# auto adds pgbouncer=true only for URLs that look pooled; set true to force it.
PRISMA_PGBOUNCER=auto
# Production defaults to requiring a pooler-looking DATABASE_URL. Set false only
# for a deliberate small single-instance deployment.
DB_POOLER_REQUIRED=true

# JWT Secret
JWT_SECRET=your-jwt-secret
AUTH_CSRF_SECRET=replace-with-a-different-32-byte-random-secret
DEVICE_LINK_SECRET=replace-with-a-random-device-link-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# auto: require server-side sessions in production/local Redis, but allow bearer JWTs
# to survive dev-server restarts when remote Upstash Redis is intentionally skipped.
AUTH_REQUIRE_SESSION_ID=auto
AUTH_PASSWORD_MIN_LENGTH=6
AUTH_PASSWORD_BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Set to .vormex.in when the frontend and API are same-site subdomains.
AUTH_COOKIE_DOMAIN=

# Server (backend :5000, web :3000)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Hackathon board import sources (free public feeds; no API keys required)
DEVFOLIO_HACKATHONS_URL=https://devfolio.co/hackathons
MLH_EVENTS_URL=https://www.mlh.com/seasons/2026/events
DEVPOST_HACKATHONS_API_URL=https://devpost.com/api/hackathons
DEVPOST_MAX_PAGES=12
HACKEREARTH_CHALLENGES_URL=https://www.hackerearth.com/api/community/challenges/compete/
HACKATHON_AUTO_IMPORT_ENABLED=true
HACKATHON_AUTO_IMPORT_INTERVAL_MS=900000
HACKATHON_INSTANT_NOTIFICATIONS_ENABLED=true
HACKATHON_INSTANT_NOTIFICATION_LIMIT=50

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback

# Google OAuth
# NEXT_PUBLIC_GOOGLE_CLIENT_ID in the web/admin apps must match GOOGLE_CLIENT_ID_WEB.
# GOOGLE_CLIENT_SECRET belongs on the backend only.
GOOGLE_CLIENT_ID_WEB=your-google-web-client-id
GOOGLE_CLIENT_ID_ANDROID=your-google-android-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3001

# Encryption Key (must be exactly 64 hex characters - 32 bytes)
ENCRYPTION_KEY=replace-with-a-64-character-hex-encryption-key
# Temporary fallback used only during a controlled key rotation. Remove after verification.
ENCRYPTION_KEY_PREVIOUS=

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@your-verified-domain.com
# Optional: override the logo used in OTP emails. If EMAIL_LOGO_PATH exists, it is embedded inline.
EMAIL_LOGO_PATH=
EMAIL_LOGO_URL=https://vormex.in/logo.png

